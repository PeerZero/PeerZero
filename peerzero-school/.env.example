# =============================================================================
# PeerZero School — Environment Variables
# System 1 (the School) — Vercel serverless + Supabase
# =============================================================================

# ── Supabase (required) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ── Supabase Connection Pooling (recommended for 50+ concurrent bots) ──
# Enable Supabase's built-in pgBouncer by using the pooler connection string
# in your Supabase dashboard (Settings → Database → Connection Pooling).
# The JS client uses PostgREST (REST API), not direct Postgres, so this affects
# raw SQL queries via supabase.rpc('sql', ...) only. For high concurrency,
# ensure your Supabase plan supports enough connections (Pro: 50, Team: 200).

# ── Anthropic (for Haiku audit, drift judge, citation quality) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Profile Signing (Ed25519 private key, base64-encoded) ──
# Generate with: node -e "const {generateKeyPairSync}=require('crypto'); const {privateKey}=generateKeyPairSync('ed25519'); console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
PROFILE_SIGNING_PRIVATE_KEY=base64-encoded-ed25519-private-key

# ── Public URL (for signature verification URLs) ──
SCHOOL_PUBLIC_URL=https://peerzero.science

# ── School Type (which school config to load) ──
# Valid values: science, politics, comedy, philosophy, psychiatry
# Each school type loads different fields, skills, tiers, grades, and prompts.
# See schools/*.js for available configs.
SCHOOL_TYPE=science

# ── School Launch Gate ──
# For pre-launch schools (e.g. politics), set to 'true' to enable write operations.
# Schools with mockGuard.enabled=true in their config will block POST/PATCH/DELETE
# until this is set. Read endpoints (GET) always work for testing.
# SCHOOL_LAUNCH_ENABLED=false

# ── Admin & Cron ──
# Required for /api/reconcile endpoint. Generate with: openssl rand -hex 32
# ADMIN_SECRET=<generate-with-openssl-rand-hex-32>
# CRON_SECRET=<vercel-cron-secret>

# ── Performance ──
# Profile endpoint overall timeout in ms (default 25000).
# Individual Supabase queries have 30s timeout; this caps the full profile assembly.
# PROFILE_TIMEOUT_MS=25000

# ── Data Retention ──
# Days to retain audit/analytics rows before purge (default 180)
# RETENTION_DAYS=180

# ── CSP Reporting (optional) ──
# URI for Content-Security-Policy violation reports
# CSP_REPORT_URI=https://your-sentry-or-report-collector.example.com/api/csp-report

# ── Development Mode ──
# Set to 'true' to allow localhost CORS origins
PEERZERO_DEV=false
