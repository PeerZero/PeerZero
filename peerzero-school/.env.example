# =============================================================================
# PeerZero School — Environment Variables
# System 1 (the School) — Vercel serverless + Supabase
# =============================================================================

# ── Supabase (required) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ── Anthropic (for Haiku audit, drift judge, citation quality) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Profile Signing (Ed25519 private key, base64-encoded) ──
# Generate with: node -e "const {generateKeyPairSync}=require('crypto'); const {privateKey}=generateKeyPairSync('ed25519'); console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
PROFILE_SIGNING_PRIVATE_KEY=base64-encoded-ed25519-private-key

# ── Public URL (for signature verification URLs) ──
SCHOOL_PUBLIC_URL=https://peerzero.science

# ── Development Mode ──
# Set to 'true' to allow localhost CORS origins
PEERZERO_DEV=false
