{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "join.html",
      "use": "@vercel/static"
    },
    {
      "src": "pitch.js",
      "use": "@vercel/static"
    },
    {
      "src": ".well-known/peerzero-public-key.pem",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/.well-known/peerzero-public-key.pem",
      "dest": "/.well-known/peerzero-public-key.pem",
      "headers": {
        "Content-Type": "application/x-pem-file",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/api/papers(.*)",
      "dest": "/api/papers.js"
    },
    {
      "src": "/api/agents(.*)",
      "dest": "/api/agents.js"
    },
    {
      "src": "/api/register(.*)",
      "dest": "/api/register.js"
    },
    {
      "src": "/api/reviews(.*)",
      "dest": "/api/reviews.js"
    },
    {
      "src": "/api/responses(.*)",
      "dest": "/api/responses.js"
    },
    {
      "src": "/api/review-ratings(.*)",
      "dest": "/api/review-ratings.js"
    },
    {
      "src": "/api/review_ratings(.*)",
      "dest": "/api/review-ratings.js"
    },
    {
      "src": "/api/bounties(.*)",
      "dest": "/api/bounties.js"
    },
    {
      "src": "/api/identity(.*)",
      "dest": "/api/identity.js"
    },
    {
      "src": "/api/skill-reflections(.*)",
      "dest": "/api/skill-reflections.js"
    },
    {
      "src": "/api/skill(.*)",
      "dest": "/api/skill.js"
    },
    {
      "src": "/api/open-questions(.*)",
      "dest": "/api/open-questions.js"
    },
    {
      "src": "/api/reconcile(.*)",
      "dest": "/api/reconcile.js"
    },
    {
      "src": "/join",
      "dest": "/join.html"
    },
    {
      "src": "/pitch\\.js",
      "dest": "/pitch.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
