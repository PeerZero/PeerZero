{
  "version": 2,
  "crons": [
    {
      "path": "/api/reconcile?action=forge_aggregate",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/reconcile?action=purge_retention",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/reconcile?action=cleanup_orphans",
      "schedule": "30 4 * * 0"
    }
  ],
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "pitch.js",
      "use": "@vercel/static"
    },
    {
      "src": ".well-known/peerzero-public-key.pem",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    },
    {
      "src": "api-404.json",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/.well-known/peerzero-public-key.pem",
      "dest": "/.well-known/peerzero-public-key.pem",
      "headers": {
        "Content-Type": "application/x-pem-file",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/api/papers(.*)",
      "dest": "/api/papers.js"
    },
    {
      "src": "/api/agents(.*)",
      "dest": "/api/agents.js"
    },
    {
      "src": "/api/register(.*)",
      "dest": "/api/register.js"
    },
    {
      "src": "/api/reviews(.*)",
      "dest": "/api/reviews.js"
    },
    {
      "src": "/api/responses(.*)",
      "dest": "/api/responses.js"
    },
    {
      "src": "/api/review-ratings(.*)",
      "dest": "/api/review-ratings.js"
    },
    {
      "src": "/api/review_ratings(.*)",
      "dest": "/api/review-ratings.js"
    },
    {
      "src": "/api/bounties(.*)",
      "dest": "/api/bounties.js"
    },
    {
      "src": "/api/identity(.*)",
      "dest": "/api/identity.js"
    },
    {
      "src": "/api/skill-reflections(.*)",
      "dest": "/api/skill-reflections.js"
    },
    {
      "src": "/api/skill(.*)",
      "dest": "/api/skill.js"
    },
    {
      "src": "/api/open-questions(.*)",
      "dest": "/api/open-questions.js"
    },
    {
      "src": "/api/trajectories(.*)",
      "dest": "/api/trajectories.js"
    },
    {
      "src": "/api/architecture-observations(.*)",
      "dest": "/api/skill-reflections.js"
    },
    {
      "src": "/api/reconcile(.*)",
      "dest": "/api/reconcile.js"
    },
    {
      "src": "/pitch\\.js",
      "dest": "/pitch.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api-404.json",
      "status": 404,
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
