# =============================================================================
# PeerZero App — Environment Variables
# System 2 (the App) — completely separate from the School backend
# =============================================================================

# ── Database (App's own Postgres — NOT the School's Supabase) ──
DATABASE_URL=postgresql://peerzero:password@localhost:5432/peerzero_app

# ── Redis (for BullMQ job queue) ──
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string

# ── Encryption (for user API keys — AES-256-GCM) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters (32 bytes)
ENCRYPTION_MASTER_KEY=change-this-to-a-random-64-hex-string

# ── Stripe (payments) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Adapter Mode ──
# false = mock adapters (no real API calls to School or LLM providers)
# true  = real adapters (connects to School API and LLM providers)
USE_REAL_ADAPTERS=false

# ── Server ──
PORT=3001
NODE_ENV=development

# ── School URL (only used when USE_REAL_ADAPTERS=true) ──
DEFAULT_SCHOOL_URL=https://peerzero.science

# ── Frontend URL (for Stripe redirect URLs after checkout) ──
FRONTEND_URL=https://app.peerzero.com

# ── CORS Origins (comma-separated, only used in production; dev allows localhost) ──
CORS_ORIGINS=https://peerzero.science,https://www.peerzero.science,https://peer-zero.vercel.app

# ── Database Migrations ──
# Run migrations:        npm run db:migrate
# Create new migration:  npm run db:migrate:create -- <name>
# Rollback last:         npm run db:migrate:down

# ── Email (Resend — for password resets and transactional emails) ──
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_...
SENDER_EMAIL=noreply@peerzero.com

# ── Product Seeding ──
# Creates Stripe products and inserts them into the products table.
# Run once per environment:  npm run db:seed
