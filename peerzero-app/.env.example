# =============================================================================
# PeerZero App — Environment Variables
# System 2 (the App) — completely separate from the School backend
# =============================================================================

# ── Database (App's own Postgres — NOT the School's Supabase) ──
DATABASE_URL=postgresql://peerzero:password@localhost:5432/peerzero_app

# ── Redis (for BullMQ job queue) ──
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string

# ── Encryption (for user API keys — AES-256-GCM) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters (32 bytes)
ENCRYPTION_MASTER_KEY=change-this-to-a-random-64-hex-string

# ── Stripe (payments) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Adapter Mode ──
# false = mock adapters (no real API calls to School or LLM providers)
# true  = real adapters (connects to School API and LLM providers)
USE_REAL_ADAPTERS=false

# ── Server ──
PORT=3001
NODE_ENV=development

# ── School URL (only used when USE_REAL_ADAPTERS=true) ──
# If unset, falls back to PEERZERO_URL (same var the bot uses) before the
# hardcoded default, so one var can drive both systems in local deployments.
DEFAULT_SCHOOL_URL=https://peerzero.science

# ── App Base URL (for transactional email links, e.g. parental consent) ──
APP_BASE_URL=https://app.peerzero.com

# ── Frontend URL (for Stripe redirect URLs after checkout) ──
FRONTEND_URL=https://app.peerzero.com

# ── CORS Origins (comma-separated, only used in production; dev allows localhost) ──
CORS_ORIGINS=https://peerzero.science,https://www.peerzero.science,https://peer-zero.vercel.app

# ── Database Connection Pool (optional — defaults work for most deployments) ──
# Tune these for high concurrency (50+ concurrent bots).
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONN_TIMEOUT=15000

# ── Database Migrations ──
# Run migrations:        npm run db:migrate
# Create new migration:  npm run db:migrate:create -- <name>
# Rollback last:         npm run db:migrate:down

# ── Email (Resend — for password resets and transactional emails) ──
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_...
SENDER_EMAIL=noreply@peerzero.com

# ── Error Tracking (Sentry — optional) ──
# Sign up at https://sentry.io and create a Node.js project to get a DSN.
# Without this, errors are logged to stdout only (Pino JSON).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── CSP Reporting (optional) ──
# URI for Content-Security-Policy violation reports
# CSP_REPORT_URI=https://o0.ingest.sentry.io/api/0/security/?sentry_key=examplePublicKey

# ── Admin Secrets ──
# Admin secret for School API agent deletion (GDPR erasure)
SCHOOL_ADMIN_SECRET=
# Admin secret for emergency stop endpoint
ADMIN_SECRET=

# ── Resend Webhooks ──
# Resend webhook signature verification secret
RESEND_WEBHOOK_SECRET=

# ── CAN-SPAM Compliance ──
# Physical mailing address for transactional emails
COMPANY_ADDRESS=548 Market St #89525, San Francisco, CA 94104

# ── Database Tuning (optional) ──
# Database statement timeout in milliseconds (optional, default: 30000)
# DB_STATEMENT_TIMEOUT=30000

# ── Product Seeding ──
# Creates Stripe products and inserts them into the products table.
# Run once per environment:  npm run db:seed
