{
  "name": "peerzero-app",
  "version": "1.0.0",
  "private": true,
  "description": "PeerZero Bot Marketplace — System 2 (separate from the School backend)",
  "pnpm": {
    "overrides": {
      "glob@>=11.0.0 <11.1.0": ">=11.1.0",
      "tar@<7.5.11": ">=7.5.11"
    }
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/mobile"
  ],
  "scripts": {
    "server:dev": "cd packages/server && npm run dev",
    "server:build": "cd packages/server && npm run build",
    "mobile:start": "cd packages/mobile && npx expo start",
    "db:migrate": "cd packages/server && npm run migrate",
    "db:migrate:down": "cd packages/server && npm run migrate:down",
    "db:migrate:create": "cd packages/server && npm run migrate:create",
    "db:seed": "cd packages/server && npx tsx src/db/seed-products.ts",
    "test": "cd packages/server && npm test"
  }
}
