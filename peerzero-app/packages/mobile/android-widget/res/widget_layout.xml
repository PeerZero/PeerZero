<?xml version="1.0" encoding="utf-8"?>
<!-- PeerZero home screen widget layout
     Dark background matching the app's theme (#0A0E1A)
     Shows: avatar | name + status | activity headline | credibility -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/widget_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        android:contentDescription="Bot avatar" />

    <!-- Info column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <!-- Name + status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_bot_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#8B93A8"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Activity headline -->
        <TextView
            android:id="@+id/widget_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#B0B8CC"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="4dp" />

        <!-- Credibility -->
        <TextView
            android:id="@+id/widget_credibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#00D2FF"
            android:paddingTop="4dp" />
    </LinearLayout>
</LinearLayout>
