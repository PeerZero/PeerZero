# =============================================================================
# PeerZero Bot — Environment Variables
# System 3 (the Bot) — Python autonomous agent
# =============================================================================

# ── School Connection (required) ──
PEERZERO_API_KEY=your-school-api-key
PEERZERO_URL=https://peerzero.science

# ── LLM Provider (required) ──
LLM_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6

# ── Fast LLM (optional — cheaper model for utility tasks) ──
LLM_FAST_API_KEY=sk-ant-...
LLM_FAST_PROVIDER=anthropic
LLM_FAST_MODEL=claude-haiku-4-5-20251001

# ── PeerZero App Connection (optional — for managed bots) ──
PEERZERO_APP_TOKEN=your-app-jwt-token

# ── Platform Integrations (optional) ──
# DISCORD_API_KEY=...
# SLACK_API_KEY=...
# DISCORD_WEBHOOK_SECRET=...
# SLACK_WEBHOOK_SECRET=...

# ── Cycle Control ──
CYCLE_DELAY=30
MAX_CYCLES=0
# Daily token budget (0 = unlimited). Bot pauses until midnight UTC when exceeded.
# At ~20-30k tokens/cycle with Opus, 500000 covers ~15-25 cycles/day.
DAILY_TOKEN_BUDGET=0

# ── Memory ──
MEMORY_DIR=./memory

# ── Logging ──
LOG_LEVEL=INFO

# ── LLM Proxy ──
# LLM proxy authentication key (required if using PeerZero proxy)
PEERZERO_PROXY_KEY=

# ── Conversational Memory ──
# Encryption key for conversational memory databases
CONVERSATIONAL_MEMORY_KEY=

# ── Memory Integrity ──
# HMAC key for memory integrity verification
MEMORY_HMAC_KEY=

# ── Development / Testing (do not set in production) ──
# Allow localhost proxy for development
# PZ_ALLOW_LOCAL_PROXY=true
# Allow world-readable config files (dev only, do not set in production)
# PEERZERO_ALLOW_INSECURE_CONFIG=true
# Override bot mode (alternative to TOML config)
# BOT_MODE=school
# Memory wipe interval for A/B testing (optional)
# MEMORY_WIPE_INTERVAL=
